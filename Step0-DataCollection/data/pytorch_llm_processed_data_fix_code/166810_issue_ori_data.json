    "class Tanh(InplaceFunction):",
    "",
    "    def forward(self, i):",
    "        if self.inplace:",
    "            self.mark_dirty(i)",
    "            result = i.tanh_()",
    "        else:",
    "            result = i.tanh()",
    "        self.save_for_backward(result)",
    "        return result",
    "",
    "    def backward(self, grad_output):",
    "        result, = self.saved_tensors",
    "        return grad_output * (1 - result * result)",
    "",
    "",
    "class Sigmoid(InplaceFunction):",
    "",
    "    def forward(self, i):",
    "        if self.inplace:",
    "            self.mark_dirty(i)",
    "            result = i.sigmoid_()",
    "        else:",
    "            result = i.sigmoid()",
    "        self.save_for_backward(result)",
    "        return result",
    "",
    "    def backward(self, grad_output):",
    "        result, = self.saved_tensors",
    "        return grad_output * ((1 - result) * result)",
    "",
    "",
