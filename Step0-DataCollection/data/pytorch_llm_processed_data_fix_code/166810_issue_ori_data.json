    "class Cmax(Function):",
    "",
    "    def forward(self, a, b):",
    "        self._max_buffer = a.gt(b).typeAs(a)",
    "        return a.cmax(b)",
    "",
    "    def backward(self, grad_output):",
    "        return (",
    "            grad_output * self._max_buffer,",
    "            grad_output * self._max_buffer.eq(0).typeAs(grad_output)",
    "        )",
    "",
