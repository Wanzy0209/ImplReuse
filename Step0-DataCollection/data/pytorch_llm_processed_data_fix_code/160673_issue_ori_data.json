    "        os.system(",
    "            f\"cd {folder}/tmp/torch/lib/; \"",
    "            f\"patchelf --set-rpath '$ORIGIN' --force-rpath {lib_name}\"",
    "        )",
    "",
    "def copy_and_patch_library(src_path: str, folder: str) -> None:",
    "    \"\"\"Copy a library to torch/lib and patch its RPATH\"\"\"",
