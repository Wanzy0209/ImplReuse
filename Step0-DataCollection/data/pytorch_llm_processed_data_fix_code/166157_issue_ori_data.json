    "        size = 10 * 1024 * 1024 // 4  # 10MB in float32",
    "        x = torch.empty(size, device=\"openreg\")",
    "        self.assertEqual(x.device.type, \"openreg\")",
    "        self.assertEqual(x.numel(), size)",
