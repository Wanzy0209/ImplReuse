    "        gc.collect()",
    "",
    "        # Note: OpenRegDeviceAllocator.emptyCache is currently a no-op",
    "        # This test ensures it doesn't crash",
    "        torch.cuda.empty_cache() if torch.cuda.is_available() else None",
    "",
    "    def test_memory_format_allocation(self):",
