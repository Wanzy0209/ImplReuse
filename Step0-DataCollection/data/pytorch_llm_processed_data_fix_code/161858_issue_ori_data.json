    "        >>> x = torch.tensor([1, 2, 3]).storage()",
    "        >>> torch.is_storage(x)",
    "        True",
    "        >>> y = torch.tensor([1, 2, 3])",
    "        >>> torch.is_storage(x)",
    "        False",
