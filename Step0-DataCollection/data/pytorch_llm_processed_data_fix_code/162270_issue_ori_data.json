    "",
    "template <EmbeddingBagMode M, typename T, typename I>",
    "void embedding_bag_impl(",
    "    constant T* weight,",
    "    constant I* indices,",
    "    constant I* offsets,",
    "    constant T* per_sample_weights,",
    "    device T* output,",
