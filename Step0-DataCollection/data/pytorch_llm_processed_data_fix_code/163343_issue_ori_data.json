    "#define _HIDDEN_NS_1(n1) namespace n1 __attribute__((visibility(\"hidden\")))",
    "  namespace n2 __attribute__((visibility(\"hidden\")))",
    "  namespace n1 {                 \\",
    "  namespace n2 {                 \\",
