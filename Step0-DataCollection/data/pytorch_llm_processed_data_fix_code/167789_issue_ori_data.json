    "                if n == 0:",
    "                    return x",
    "                return fn(x, n - 1) + 1",
    "",
    "            sys.setrecursionlimit(100)",
    "",
    "            with self.assertRaises(RecursionError):",
    "                fn(torch.ones(3), 1000)",
    "",
    "            sys.setrecursionlimit(2000)",
