    "from typing import Callable",
    "        from torch._inductor.pattern_matcher import fwd_only, PatternMatcherPass",
    "    def test_multioutput_replacement(self):",
    "        @torch.library.custom_op(\"mylib::fused_relu_add\", mutates_args=[])",
