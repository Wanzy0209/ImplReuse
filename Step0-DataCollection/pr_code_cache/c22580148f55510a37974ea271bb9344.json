    "    version(\"3.8\", sha256=\"a12ccd50f57083c530e1c76f10d52865defbd19fc9e2c85b483493065709874a\")  # py-torch@2.8:",
    "    version(\"3.7.0_2024-12-06\", commit=\"56e1f79cb140fb9326d612d0be06b5250565cade\")  # py-torch@2.7",
