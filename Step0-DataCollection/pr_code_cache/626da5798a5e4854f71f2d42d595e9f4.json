    "    aten__int_mm,",
    "    aten_addmm,",
    "    aten_bias_addmm,",
    "    aten_mm,",
    "    aten_mm_dtype,",
    ")",
    "@register_template_heuristic(aten_mm_dtype.uid, \"cuda\")",
    "def meta_mm(a, b, out_dtype: Optional[torch.dtype] = None):",
    "    if out_dtype is not None:",
    "        torch._check(",
    "            out_dtype == a.dtype",
    "            or (",
    "                out_dtype == torch.float32",
