    "                raise RuntimeError(",
    "                    f\"Compile package was created with a different CUDA version: {self.cuda_version}\"",
    "                )",
    "",
    "            if (",
    "                other.triton_version != (0, 0)",
    "                and self.triton_version != other.triton_version",
