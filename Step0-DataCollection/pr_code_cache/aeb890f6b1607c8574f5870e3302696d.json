    "            )",
    "",
    "        if self.torch_version != other.torch_version:",
    "            raise RuntimeError(",
    "                f\"Compile package was created with a different PyTorch version: {self.torch_version}\"",
    "            )",
    "",
    "        if use_cuda:",
    "            if not torch.cuda.is_available():",
    "                raise RuntimeError(\"CUDA is not available\")",
