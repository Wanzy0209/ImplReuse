    "  const void *b, int64_t ldb,",
    "  const Scalar& beta,",
    "  void *c, int64_t ldc) {",
    "_AT_DISPATCH_GEMM_TYPES(type, \"cpublas_gemm_no_downcast_impl\", [&]{",
