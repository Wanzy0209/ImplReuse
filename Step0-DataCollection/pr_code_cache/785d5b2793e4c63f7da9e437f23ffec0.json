    "          beta.to<opmath_t>(),",
    "          static_cast<opmath_t *>(c), ldc);",
    "    });",
    "}",
    "",
    "REGISTER_DISPATCH(cpublas::gemm_no_downcast_stub, &cpublas::cpublas_gemm_no_downcast_impl)"
