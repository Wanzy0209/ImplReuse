    "  }",
    "  return std::make_tuple(std::move(LU), std::move(pivots));",
    "}",
    "",
    "TORCH_IMPL_FUNC(linalg_lu_solve_out_mps)(const Tensor& LU,",
    "                                     const Tensor& pivots,",
    "                                     const Tensor& B,",
    "                                     bool left,",
    "                                     bool adjoint,",
    "                                     const Tensor& result) {",
    "  // Trivial case",
    "  if (result.numel() == 0) {",
    "    return;",
    "  }",
