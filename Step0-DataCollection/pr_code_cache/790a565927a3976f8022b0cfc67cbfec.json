    "                \"update reduction constant mask value to match dst_dtype\"",
    "",
    "                # int is the only mask which may not fit within lower bitwidth,",
    "                # because float uses inf/-inf",
    "                if src_dtype.is_floating_point or src_dtype == torch.bool:",
