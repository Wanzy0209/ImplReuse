    "  _(c10::complex<double>, ComplexDouble)                                \\",
    "  _(bool, Bool)                                                         \\",
    "  _(at::BFloat16, BFloat16)                                             \\",
    "  _(at::Float8_e5m2, Float8_e5m2)                                       \\",
    "  _(at::Float8_e4m3fn, Float8_e4m3fn)",
    "",
    "// This macro controls many of our C++ APIs, including constructors",
