    "      data_(data),",
    "      size_(size),",
    "      device_(device),",
    "      stream_(stream) {}",
    "",
    "void CUDAPluggableAllocatorDeleterContext::free() {",
    "  free_fn_(data_, size_, device_, stream_);",
    "  delete this;",
    "}",
    "",
    "    std::function<MallocFuncType> alloc_fn,",
