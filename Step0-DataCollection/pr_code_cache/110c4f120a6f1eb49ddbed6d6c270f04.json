    "          value_size_last % alignment == 0 && value_size_last > 0)) {",
    "      if (debug) {",
    "        TORCH_WARN(",
    "            \"Mem efficient attention requires last dimension of inputs to be divisible by \",",
    "            alignment,",
    "            \". \",",
    "            \"Got Query.size(-1): \",",
    "            query_size_last,",
    "            \", Key.size(-1): \",",
    "            params.key.sym_size(-1),",
    "            \", Value.size(-1): \",",
    "            params.value.sym_size(-1),",
    "            \" instead.\");",
    "      }",
    "      return false;",
    "    }",
    "  }",
