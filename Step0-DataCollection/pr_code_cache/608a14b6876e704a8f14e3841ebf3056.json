    "    class MLPModule(nn.Module):",
    "        def __init__(self, device):",
    "            super().__init__()",
    "            torch.manual_seed(5)",
    "            self.net1 = nn.Linear(10, 16, bias=True, device=device)",
    "            self.relu = nn.ReLU()",
    "            self.net2 = nn.Linear(16, 10, bias=True, device=device)",
    "",
    "        def forward(self, x):",
    "            a = self.net1(x)",
    "            b = self.relu(a)",
    "            c = self.net2(b)",
    "            return c",
    "",
    "    class MLPModule2(nn.Module):",
    "        def __init__(self, device):",
    "            super().__init__()",
    "            torch.manual_seed(5)",
    "            self.net1 = nn.Linear(10, 16, bias=True, device=device)",
    "            self.relu = nn.ReLU()",
    "            self.net2 = nn.Linear(16, 10, bias=True, device=device)",
    "",
    "        def forward(self, x):",
    "            d = self.net1(x)",
    "            e = self.relu(d)",
    "            f = self.net2(e)",
    "            return f",
    "",
    "        mod = self.MLPModule(device)",
    "        # reset cache to start fresh",
