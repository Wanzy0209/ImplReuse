    "",
    "        class YoloMode(TorchDispatchMode):",
    "            def __torch_dispatch__(self, func, types, args=(), kwargs=None):",
    "                out = torch.compile(func, backend=backend, fullgraph=True)(",
    "                    *args, **kwargs",
    "                )",
    "                return out",
    "",
    "        x = torch.randn(5)",
    "        with YoloMode():",
    "            out = torch.add(x, x)",
    "",
