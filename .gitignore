# Python 缓存
__pycache__/
*.py[cod]
.pytest_cache/

# IDE
.idea/
.vscode/

# CodeBERT 模型权重（单文件超过 100MB，GitHub 拒收；可用 huggingface 重新下载）
codebert-base/

# 第三方框架完整源码（体积过大，可从官方获取）
Step2-CalculateSimilarity/data/pytorch-code/
Step2-CalculateSimilarity/data/tensorflow-code/

# API 源码提取产物与提取缓存（可由 1-extract-*.py 重新生成；内含超过 100MB 的文件）
Step2-CalculateSimilarity/data/pytorch-api-extracted/
Step2-CalculateSimilarity/data/tensorflow-api-extracted/
Step2-CalculateSimilarity/*_extraction_cache.json

# zip 打包副本（对应目录/文件本身已纳入版本控制）
*.zip
# 例外：以下 zip 是对应超大 jsonl 的压缩版，jsonl 本体超过 GitHub 100MB 限制不入库
!Step2-CalculateSimilarity/data/api_pairwise_similarity.zip
!Step2-CalculateSimilarity/data/issue_api_similarity.zip
# 稀疏文件，实际大小超过 100MB（GitHub 硬限制），以同名 zip 形式入库
Step2-CalculateSimilarity/data/api_pairwise_similarity.jsonl
Step2-CalculateSimilarity/data/issue_api_similarity.jsonl

# 调试用 profiler trace 文件
*.pt.trace.json*
